---
// Page shell: head tags (canonical, Open Graph, Twitter card, JSON-LD), header with the mark and the
// site nav, footer with the repositories. No client JavaScript anywhere on the site.
import Logo from "../components/Logo.astro";
import { HOME_URL, REPOS } from "../lib/config";
import { DESCRIPTION, DISCLAIMER, NAME, pageTitle } from "../lib/brand";

interface Props {
  title: string;
  description?: string;
  /** out of search engines (the error page) */
  noindex?: boolean;
  /** extra JSON-LD objects for the page, appended to the site's own */
  structured?: Record<string, unknown>[];
}
const { title, description = DESCRIPTION, noindex = false, structured = [] } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const site = Astro.site!.href;
const here = Astro.url.pathname;
const current = (path: string) => (here === path ? "page" : undefined);
// JSON inside <script>: "</" must not appear raw
const jsonLd = (d: Record<string, unknown>) => JSON.stringify(d).replace(/</g, "\\u003c");
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: NAME,
      description: DESCRIPTION,
      inLanguage: "pt-BR",
      publisher: { "@id": `${site}#person` },
    },
    {
      "@type": "Person",
      "@id": `${site}#person`,
      name: "Vitor Ayres",
      url: "https://virtuaires.com.br",
      sameAs: ["https://github.com/vasfvitor", "https://www.linkedin.com/in/ayresvitor/"],
    },
    ...structured,
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ANVISA em dados abertos, anvisa.abelhaninja.de" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <header class="site">
      <a class="mark" href="/" aria-label={NAME}>
        <Logo />
        <span>{NAME}</span>
      </a>
      <nav aria-label="Seções">
        <a href="/" aria-current={current("/")}>
          Início
        </a>
        <a href="/dados/" aria-current={current("/dados/")}>
          Dados
        </a>
        <a href="/sobre/" aria-current={current("/sobre/")}>
          Sobre
        </a>
        <a href={REPOS.hub}>GitHub</a>
      </nav>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      <p class="aviso">{DISCLAIMER}</p>
      <nav aria-label="Repositórios">
        <a href={REPOS.api}>anvisa-api</a>
        <a href={REPOS.dash}>anvisa-dash</a>
        <a href={REPOS.feeds}>anvisa-feeds</a>
        <a href={REPOS.hub}>anvisa-hub</a>
        <a href={HOME_URL}>abelhaninja.de</a>
      </nav>
      <p class="licenca">
        Código MIT. Dados da ANVISA e da CMED, sem alteração. <a href="https://virtuaires.com.br">Vitor Ayres</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf7;
    --fg: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #c99a06;
    --accent-ink: #7a5c00;
    --card: #ffffff;
    --line: #e4e1d8;
    --up: #15803d;
    --down: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --fg: #ededed;
      --muted: #9a9a9a;
      --accent: #f0c23b;
      --accent-ink: #f0c23b;
      --card: #1c1c1c;
      --line: #2c2c2c;
      --up: #4ade80;
      --down: #f87171;
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
    color: var(--fg);
    font:
      17px/1.5 system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    font-variant-numeric: tabular-nums;
  }
  body {
    margin: 0 auto;
    padding: 0 16px;
    max-width: 68rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 1px;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent-ink);
    outline: none;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--card);
    padding: 8px 12px;
  }
  .skip:focus {
    left: 16px;
  }
  header.site {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  header.site .mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 0;
    font-weight: 600;
  }
  header.site .mark svg {
    width: 34px;
    height: 34px;
  }
  header.site nav,
  footer.site nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  header.site nav a {
    border-bottom-color: transparent;
  }
  header.site nav a[aria-current="page"],
  header.site nav a:hover {
    border-bottom-color: var(--accent);
  }
  main {
    flex: 1;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    line-height: 1.1;
    margin: 2rem 0 0.5rem;
    letter-spacing: -0.01em;
  }
  h2 {
    font-size: 1.15rem;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: 1rem;
    margin: 1.25rem 0 0.4rem;
  }
  p {
    margin: 0.5rem 0;
  }
  .lead {
    color: var(--muted);
    max-width: 44rem;
    margin: 0 0 1.5rem;
    font-size: 1.1rem;
  }
  .muted {
    color: var(--muted);
  }
  .busca {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 40rem;
    margin: 0 0 0.5rem;
  }
  .busca input {
    flex: 1 1 16rem;
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
    color: var(--fg);
  }
  .busca input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  .busca button {
    font: inherit;
    font-weight: 600;
    padding: 10px 16px;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: #1a1a1a;
    cursor: pointer;
  }
  .atalhos {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 2rem;
  }
  .atalhos a {
    margin-right: 14px;
  }
  .hoje {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 16px 32px;
    margin: 0 0 1rem;
  }
  .hoje h3 {
    margin-top: 0.5rem;
  }
  .hoje h3 a {
    border: 0;
  }
  .hoje h3 small {
    color: var(--muted);
    font-weight: 400;
    margin-left: 6px;
  }
  ul.mov {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul.mov li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  ul.mov li:last-child {
    border-bottom: 0;
  }
  ul.mov .t {
    flex: 1;
    min-width: 0;
  }
  ul.mov .t small {
    color: var(--muted);
    display: block;
  }
  ul.mov .n {
    white-space: nowrap;
    text-align: right;
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 16px;
    margin: 0 0 2.5rem;
  }
  table.lista {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.95rem;
  }
  table.lista th {
    text-align: left;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--line);
    padding: 6px 12px 6px 0;
  }
  table.lista td {
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  table.lista td.n,
  table.lista th.n {
    text-align: right;
    white-space: nowrap;
  }
  .proveniencia {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 50rem;
  }
  footer.site {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0 2rem;
    color: var(--muted);
    font-size: 0.9rem;
    display: grid;
    gap: 12px;
  }
  footer.site .aviso {
    margin: 0;
    color: var(--fg);
  }
  footer.site .licenca {
    margin: 0;
  }
  @media (max-width: 40rem) {
    table.lista .d {
      display: none;
    }
  }
</style>
