---
// Page shell: head tags (canonical, Open Graph, Twitter card, JSON-LD), header with the mark and the
// site nav, footer with the repositories. No client JavaScript anywhere on the site.
// Astro drops a line break between text and a tag: keep inline links on the same line as their text.
import Logo from "../components/Logo.astro";
import { HOME_URL, REPOS } from "../lib/config";
import { AUTHOR, DESCRIPTION, DISCLAIMER, NAME, pageTitle } from "../lib/brand";

interface Props {
  title: string;
  description?: string;
  /** out of search engines (the error page) */
  noindex?: boolean;
  /** extra JSON-LD objects for the page, appended to the site's own */
  structured?: Record<string, unknown>[];
}
const { title, description = DESCRIPTION, noindex = false, structured = [] } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const site = Astro.site!.href;
const here = Astro.url.pathname;
const current = (path: string) => (here === path ? "page" : undefined);
// JSON inside <script>: "</" must not appear raw
const jsonLd = (d: Record<string, unknown>) => JSON.stringify(d).replace(/</g, "\\u003c");
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: NAME,
      description: DESCRIPTION,
      inLanguage: "pt-BR",
      publisher: { "@id": `${site}#org` },
    },
    {
      "@type": "Organization",
      "@id": `${site}#org`,
      name: AUTHOR.name,
      url: AUTHOR.url,
      sameAs: ["https://github.com/vasfvitor"],
    },
    ...structured,
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf8ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ANVISA em dados abertos, anvisa.abelhaninja.de" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <header class="site">
      <a class="mark" href="/" aria-label={NAME}>
        <Logo />
        <span>{NAME}</span>
      </a>
      <nav aria-label="Seções">
        <a href="/" aria-current={current("/")}>
          Início
        </a>
        <a href="/dados/" aria-current={current("/dados/")}>
          Dados
        </a>
        <a href="/sobre/" aria-current={current("/sobre/")}>
          Sobre
        </a>
      </nav>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      <p class="aviso">{DISCLAIMER}</p>
      <nav aria-label="Repositórios">
        <a href={REPOS.api}>anvisa-api</a>
        <a href={REPOS.dash}>anvisa-dash</a>
        <a href={REPOS.feeds}>anvisa-feeds</a>
        <a href={REPOS.hub}>anvisa-hub</a>
        <a href={HOME_URL}>abelhaninja.de</a>
      </nav>
      <p class="licenca">
        Código MIT. Dados da ANVISA e da CMED, sem alteração. <a href={AUTHOR.url}>{AUTHOR.name}</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbf8ef;
    --fg: #1c1a14;
    --muted: #6d6758;
    --accent: #e0ad12;
    --accent-ink: #7a5c00;
    --accent-soft: rgba(224, 173, 18, 0.14);
    --card: #ffffff;
    --line: #e6e0cf;
    --up: #157a3a;
    --down: #b42318;
    --shadow: 0 1px 2px rgba(28, 26, 20, 0.06), 0 8px 24px rgba(28, 26, 20, 0.06);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111110;
      --fg: #ebe8df;
      --muted: #9b968a;
      --accent: #f0c23b;
      --accent-ink: #f0c23b;
      --accent-soft: rgba(240, 194, 59, 0.12);
      --card: #1a1917;
      --line: #2b2a26;
      --up: #4ade80;
      --down: #f87171;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.35);
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg) radial-gradient(80rem 26rem at 35% -8rem, var(--accent-soft), transparent 70%) no-repeat;
    color: var(--fg);
    font:
      17px/1.5 system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    font-variant-numeric: tabular-nums;
  }
  body {
    margin: 0 auto;
    padding: 0 16px;
    max-width: 68rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 1px;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent-ink);
    outline: none;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--card);
    padding: 8px 12px;
  }
  .skip:focus {
    left: 16px;
  }
  header.site {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 18px 0;
  }
  header.site .mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 0;
    font-weight: 600;
  }
  header.site .mark svg {
    width: 34px;
    height: 34px;
  }
  header.site nav,
  footer.site nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  header.site nav a {
    border-bottom-color: transparent;
    font-weight: 500;
  }
  header.site nav a[aria-current="page"],
  header.site nav a:hover {
    border-bottom-color: var(--accent);
  }
  main {
    flex: 1;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    margin: 2.5rem 0 0.75rem;
    letter-spacing: -0.02em;
  }
  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 2.75rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  h2::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  h3 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }
  p {
    margin: 0.5rem 0;
  }
  .lead {
    color: var(--muted);
    max-width: 40rem;
    margin: 0 0 1.75rem;
    font-size: 1.15rem;
  }
  .muted {
    color: var(--muted);
  }
  .busca {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 42rem;
    margin: 0 0 0.75rem;
  }
  .busca input {
    flex: 1 1 16rem;
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--fg);
    box-shadow: var(--shadow);
  }
  .busca input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  .busca button {
    font: inherit;
    font-weight: 600;
    padding: 12px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: #1c1a14;
    cursor: pointer;
    box-shadow: var(--shadow);
  }
  .busca button:hover {
    filter: brightness(1.05);
  }
  .atalhos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 2rem;
    font-size: 0.9rem;
  }
  .atalhos a {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
    background: var(--card);
  }
  .atalhos a:hover {
    border-color: var(--accent);
  }
  .hoje {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 16px;
    margin: 0;
  }
  .hoje > div {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px;
    box-shadow: var(--shadow);
  }
  .hoje h3 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .hoje h3 a {
    border: 0;
  }
  .hoje h3 small {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .hoje .resumo {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 6px;
  }
  ul.mov {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul.mov li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 12px;
    align-items: start;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  ul.mov .t {
    min-width: 0;
  }
  ul.mov .t small {
    color: var(--muted);
    display: block;
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  ul.mov .n {
    white-space: nowrap;
    text-align: right;
    font-weight: 500;
  }
  ul.mov .n small {
    display: block;
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8rem;
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 16px;
    margin: 0 0 2.5rem;
  }
  table.lista {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.95rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  table.lista th {
    text-align: left;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  table.lista td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  table.lista tr:last-child td {
    border-bottom: 0;
  }
  table.lista td.n,
  table.lista th.n {
    text-align: right;
    white-space: nowrap;
  }
  .nota {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 48rem;
  }
  .sobre section {
    margin: 0 0 2rem;
  }
  .sobre p {
    max-width: 44rem;
  }
  footer.site {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding: 1.5rem 0 2rem;
    color: var(--muted);
    font-size: 0.9rem;
    display: grid;
    gap: 12px;
  }
  footer.site .aviso,
  footer.site .licenca {
    margin: 0;
  }
  footer.site .aviso {
    color: var(--fg);
  }
  @media (max-width: 40rem) {
    table.lista .d {
      display: none;
    }
    h1 {
      margin-top: 1.5rem;
    }
  }
</style>
