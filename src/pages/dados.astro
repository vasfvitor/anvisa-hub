---
// Every table of the manifest: rows, source date, what one row is, the dictionary link.
import Base from "../layouts/Base.astro";
import { DADOS_URL, MANIFEST_URL, PYPI_URL } from "../lib/config";
import { fmtDate, fmtInt } from "../lib/format";
import { besideManifest, manifestForBuild } from "../lib/manifest";

const manifest = await manifestForBuild(MANIFEST_URL);
const docsUrl = besideManifest(MANIFEST_URL, manifest.docs ?? "dicionario.html");
const tables = Object.entries(manifest.tables);
const total = tables.reduce((n, [, t]) => n + t.rows, 0);
const description = `${fmtInt(tables.length)} tabelas da ANVISA em Parquet, ${fmtInt(total)} linhas, build de ${fmtDate(manifest.built_at)}.`;
---

<Base title="Dados" description={description}>
  <h1>Dados</h1>
  <p class="lead">
    {fmtInt(tables.length)} tabelas, {fmtInt(total)} linhas, build de {fmtDate(manifest.built_at)}.
  </p>
  <table class="lista">
    <thead>
      <tr>
        <th>Tabela</th>
        <th class="d">Uma linha é</th>
        <th class="n">Linhas</th>
        <th class="n">Origem</th>
      </tr>
    </thead>
    <tbody>
      {tables.map(([name, t]) => (
        <tr>
          <td>
            <a href={`${docsUrl}#${name}`}>{name}</a>
          </td>
          <td class="d">{t.title ?? ""}</td>
          <td class="n">{fmtInt(t.rows)}</td>
          <td class="n">{t.source.loaded_at ? fmtDate(t.source.loaded_at) : "–"}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="nota">
    Os arquivos mudam de endereço a cada build; o <a href={MANIFEST_URL}>manifest</a> tem os atuais, com colunas e
    sha256. O <a href={docsUrl}>dicionário</a> descreve cada coluna. Em Python, o pacote <a href={PYPI_URL}>anvisa</a> é
    o cliente e o pipeline. Listagem em <a href={DADOS_URL}>GitHub Pages</a>.
  </p>
</Base>
