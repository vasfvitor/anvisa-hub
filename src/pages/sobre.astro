---
// What each site is, what it leaves out, and the questions people arrive with. The FAQ is visible text
// and the same text as FAQPage JSON-LD.
import Base from "../layouts/Base.astro";
import {
  ANVISA_DADOS_URL,
  CONTEM_URL,
  DADOS_URL,
  FEEDS_META_URL,
  FEEDS_URL,
  MANIFEST_URL,
  PORTAL_URL,
} from "../lib/config";
import { AUTHOR } from "../lib/brand";
import { agoraDoBuild, coletaParada, feedsMetaForBuild } from "../lib/feeds";
import { fmtDate, fmtDateTime } from "../lib/format";
import { manifestForBuild } from "../lib/manifest";

const manifest = await manifestForBuild(MANIFEST_URL);
const feeds = await feedsMetaForBuild(FEEDS_META_URL);
// the state of the last crawl, computed when the page is built: a stopped crawl is said in words
const coleta = !feeds
  ? "O resumo das filas (meta.json) não estava publicado neste build."
  : (coletaParada(feeds, agoraDoBuild()) ?? `A última coleta terminou em ${fmtDateTime(feeds.finished)}.`);

const title = "Sobre os sites";
const description =
  "O que cada site faz e o que fica de fora: contém (produtos regularizados), anvisa.feeds (filas de análise), preços CMED (lista mensal) e as tabelas em Parquet, com os valores como a ANVISA publica.";
const site = Astro.site!.href;
const faq = [
  {
    q: "Como saber se um produto está liberado na ANVISA?",
    a: `Busque no contém (${CONTEM_URL}) pela marca, nome, empresa ou CNPJ. Ele cobre alimentos e suplementos, saneantes e cosméticos, com a situação e as datas de cada regularização. Medicamentos e dispositivos ainda não estão na busca.`,
  },
  {
    q: "Como acompanhar a fila de análise de um processo?",
    a: `Em anvisa.feeds (${FEEDS_URL}) cada subfila tem uma página com a fila inteira e um feed Atom. Assine o feed da sua subfila e filtre pelo número do processo.`,
  },
  {
    q: "Onde ver o preço máximo de um medicamento?",
    a: `Em ${FEEDS_URL}cmed/, por substância ou por laboratório: PF, PMC e PMVG à alíquota 0 % e o que mudou contra a lista anterior. São os tetos da CMED, não o preço praticado. O preço máximo ao consumidor no ICMS de cada estado está em ${PORTAL_URL}remedios/.`,
  },
  {
    q: "Os dados são oficiais?",
    a: `São cópias dos arquivos públicos da ANVISA (dados.anvisa.gov.br e a API Consultas Externas), com a data de cada coleta, feitas por um projeto sem vínculo com a ANVISA. Os valores são os que a ANVISA publica; os CSVs são convertidos para Parquet, e as entradas, saídas e mudanças são calculadas pelo anvisa.feeds.`,
  },
];
const structured = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: site },
      { "@type": "ListItem", position: 2, name: "Sobre" },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description} structured={structured}>
  <div class="sobre">
    <h1>{title}</h1>
    <p class="lead">Quatro sites, um dado cada, lidos dos arquivos públicos da ANVISA.</p>

    <h2>contém</h2>
    <section>
      <p>
        <a href={CONTEM_URL}>contem.abelhaninja.de</a> responde se um produto está regularizado: alimentos e
        suplementos, saneantes, cosméticos, por marca, nome, empresa, CNPJ ou número do rótulo. Uma página por empresa.
      </p>
      <p class="muted">
        Fora: medicamentos e dispositivos, por enquanto. A busca precisa de JavaScript; as páginas de empresa não.
      </p>
    </section>

    <h2>anvisa.feeds</h2>
    <section>
      <p>
        <a href={FEEDS_URL}>anvisa.feeds.abelhaninja.de</a> mostra as filas de análise de petições, uma por subfila,
        como feed Atom. Cada entrada compara uma coleta com a anterior: quem entrou, saiu ou mudou de posição. {coleta}
      </p>
      <p class="muted">Fora: o resultado da análise. "Saiu da fila" não diz se foi deferido.</p>
    </section>

    <h2>preços CMED</h2>
    <section>
      <p>
        <a href={`${FEEDS_URL}cmed/`}>anvisa.feeds.abelhaninja.de/cmed</a> compara a lista mensal de preços máximos de
        medicamentos com a anterior. Um feed por substância e por laboratório. O preço máximo ao consumidor de cada
        apresentação, no ICMS de cada estado, está em <a href={`${PORTAL_URL}remedios/`}>saude.abelhaninja.de</a>.
      </p>
      <p class="muted">Fora: preço praticado. São tetos. Em março ou abril a lista inteira muda.</p>
    </section>

    <h2>dados abertos</h2>
    <section>
      <p>
        <a href={DADOS_URL}>Parquet no GitHub Pages</a>: os CSVs de <a href={ANVISA_DADOS_URL}>dados.anvisa.gov.br</a>,
        convertidos para Parquet pelo anvisa-api (build de {fmtDate(manifest.built_at)}), com manifest, dicionário e
        hash. É o que alimenta os outros três. A lista está em <a href="/dados/">Dados</a>.
      </p>
    </section>

    <h2>Perguntas</h2>
    <section>
      {faq.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
    </section>

    <h2>Limites</h2>
    <section>
      <p>
        Cada página mostra a data da cópia que usa; quando a coleta das filas para, o início e esta página dizem desde
        quando. O site não usa cookies nem análise de acesso.
      </p>
      <p class="muted">
        Projeto de <a href={AUTHOR.url}>{AUTHOR.name}</a>, código aberto sob MIT. Repositórios no rodapé.
      </p>
    </section>
  </div>
</Base>
