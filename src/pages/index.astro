---
// The home: a search box, what moved today, four cards. Every number is read at build time from the
// manifest of anvisa-api and the meta.json of anvisa-feeds; nothing is typed by hand.
import Card from "../components/Card.astro";
import type { Stat } from "../components/Card.astro";
import Base from "../layouts/Base.astro";
import { DESCRIPTION, TITLE } from "../lib/brand";
import {
  ANVISA_CONSULTAS_URL,
  ANVISA_DADOS_URL,
  CONTEM_URL,
  DADOS_URL,
  FEEDS_META_URL,
  FEEDS_URL,
  MANIFEST_URL,
} from "../lib/config";
import { feedsMetaForBuild, stampToDate } from "../lib/feeds";
import { fmtDate, fmtDateTime, fmtInt, fmtMoney, fmtPct } from "../lib/format";
import { besideManifest, latestLoadedAt, manifestForBuild } from "../lib/manifest";

const manifest = await manifestForBuild(MANIFEST_URL);
const feeds = await feedsMetaForBuild(FEEDS_META_URL);

const tables = manifest.tables;
const stat = (label: string, name: string): Stat[] => {
  const t = tables[name];
  return t ? [{ label, value: fmtInt(t.rows) }] : [];
};
const loadedAt = latestLoadedAt(manifest);
const cmed = feeds?.cmed;
const novidades = feeds?.novidades;
const altas = cmed?.destaques?.altas.filter((h) => h.variacao !== null && h.variacao > 0) ?? [];
const baixas = cmed?.destaques?.baixas.filter((h) => h.variacao !== null && h.variacao < 0) ?? [];

const contemStats: Stat[] = [
  ...stat("produtos", "produtos"),
  ...stat("empresas", "empresas"),
  ...(loadedAt ? [{ label: "dados de", value: fmtDate(loadedAt) }] : []),
];
const feedsStats: Stat[] = feeds
  ? [
      { label: "filas", value: fmtInt(feeds.subfilas_total) },
      { label: "na fila", value: fmtInt(feeds.rows) },
      { label: "coleta", value: fmtDateTime(feeds.finished) },
    ]
  : [];
const cmedStats: Stat[] = cmed
  ? [
      { label: "apresentações", value: fmtInt(cmed.rows) },
      { label: "substâncias", value: fmtInt(cmed.substancias) },
      { label: "lista de", value: fmtDate(stampToDate(cmed.stamp)) },
    ]
  : [];
const dadosStats: Stat[] = [
  { label: "tabelas", value: fmtInt(Object.keys(tables).length) },
  { label: "linhas", value: fmtInt(Object.values(tables).reduce((n, t) => n + t.rows, 0)) },
  { label: "build de", value: fmtDate(manifest.built_at) },
];
const docsUrl = besideManifest(MANIFEST_URL, manifest.docs ?? "dicionario.html");
const recentes = Object.entries(tables)
  .filter(([, t]) => t.source.loaded_at)
  .sort(([, a], [, b]) => (b.source.loaded_at! > a.source.loaded_at! ? 1 : -1))
  .slice(0, 4);

const products = [
  { "@type": "WebSite", name: "contém", url: CONTEM_URL, inLanguage: "pt-BR" },
  { "@type": "WebSite", name: "anvisa.feeds", url: FEEDS_URL, inLanguage: "pt-BR" },
  { "@type": "WebSite", name: "Preços CMED", url: `${FEEDS_URL}cmed/`, inLanguage: "pt-BR" },
  { "@type": "Dataset", name: "anvisa-api dados abertos", url: DADOS_URL, isBasedOn: ANVISA_DADOS_URL },
];
const structured = [
  {
    "@type": "ItemList",
    "@id": `${Astro.site!.href}#produtos`,
    name: TITLE,
    itemListElement: products.map((p, i) => ({ "@type": "ListItem", position: i + 1, item: p })),
  },
];
---

<Base title={TITLE} description={DESCRIPTION} structured={structured}>
  <h1>{TITLE}</h1>
  <p class="lead">Produtos, filas e preços, lidos todo dia dos arquivos públicos da ANVISA.</p>

  <form class="busca" action={CONTEM_URL} method="get" role="search">
    <label class="sr-only" for="q">
      Produto, marca, empresa ou CNPJ
    </label>
    <input id="q" name="q" type="search" placeholder="Produto, marca, empresa ou CNPJ" autocomplete="off" />
    <button type="submit">Buscar</button>
  </form>
  <nav class="atalhos" aria-label="Atalhos">
    <a href={`${FEEDS_URL}cmed/index.html#substancia`}>Substância na CMED</a>
    <a href={`${FEEDS_URL}index.html#filas`}>Fila pelo nome</a>
    <a href={`${CONTEM_URL}empresas/`}>Empresas de A a Z</a>
  </nav>

  <h2>Hoje</h2>
  <section class="hoje" aria-label="Mudanças mais recentes">
    <div>
      <h3>
        <a href={FEEDS_URL}>Filas</a>
        {novidades && <small>{fmtDate(novidades.dia)}</small>}
      </h3>
      {novidades ? (
        <>
          <p class="resumo">
            {fmtInt(novidades.entraram)} entraram, {fmtInt(novidades.sairam)} saíram,{" "}
            {fmtInt(novidades.filas_com_movimento)} filas
          </p>
          <ul class="mov">
            {novidades.filas.slice(0, 5).map((f) => (
              <li>
                <span class="t">
                  <a href={f.pagina}>{f.nome}</a>
                  <small>{f.area}</small>
                </span>
                <span class="n">
                  {f.entraram > 0 && <span class="up">+{f.entraram}</span>}
                  {f.entraram > 0 && f.sairam > 0 && " "}
                  {f.sairam > 0 && <span class="down">−{f.sairam}</span>}
                </span>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="resumo">Sem resumo neste build.</p>
      )}
    </div>
    <div>
      <h3>
        <a href={`${FEEDS_URL}cmed/`}>Preços CMED</a>
        {cmed && <small>{fmtDate(stampToDate(cmed.stamp))}</small>}
      </h3>
      {cmed && cmed.months > 1 ? (
        <>
          <p class="resumo">
            {fmtInt(cmed.events.changed)} mudaram, {fmtInt(cmed.events.entered)} entraram, {fmtInt(cmed.events.left)}{" "}
            saíram
          </p>
          <ul class="mov">
            {[...altas.slice(0, 3), ...baixas.slice(0, 3)].map((h) => (
              <li>
                <span class="t">
                  {h.pagina ? <a href={h.pagina}>{h.produto}</a> : h.produto}
                  <small>{h.apresentacao}</small>
                </span>
                <span class={`n ${h.variacao! > 0 ? "up" : "down"}`}>
                  {fmtPct(h.variacao!)}
                  <small>{fmtMoney(h.pf_para)}</small>
                </span>
              </li>
            ))}
          </ul>
        </>
      ) : cmed ? (
        <p class="resumo">Primeira lista guardada. As mudanças aparecem na próxima.</p>
      ) : (
        <p class="resumo">Sem lista neste build.</p>
      )}
    </div>
    <div>
      <h3>
        <a href="/dados/">Tabelas</a>
        <small>build {fmtDate(manifest.built_at)}</small>
      </h3>
      <p class="resumo">Origem mais recente</p>
      <ul class="mov">
        {recentes.map(([name, t]) => (
          <li>
            <span class="t">
              <a href={`${docsUrl}#${name}`}>{name}</a>
              <small>{t.title ?? ""}</small>
            </span>
            <span class="n">
              {fmtInt(t.rows)}
              <small>{fmtDate(t.source.loaded_at!)}</small>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <h2>Os sites</h2>
  <section class="cards" aria-label="Sites">
    <Card
      title="contém"
      icon="busca"
      href={CONTEM_URL}
      blurb="Está liberado? Alimentos, suplementos, saneantes e cosméticos."
      stats={contemStats}
      empty="Sem números neste build."
      links={[{ href: `${CONTEM_URL}empresas/`, text: "empresas" }]}
    />
    <Card
      title="anvisa.feeds"
      icon="feed"
      href={FEEDS_URL}
      blurb="Em que posição está? As filas de análise, em Atom."
      stats={feedsStats}
      empty="Resumo ainda não publicado."
      links={[{ href: `${FEEDS_URL}feeds.opml`, text: "OPML" }]}
    />
    <Card
      title="preços CMED"
      icon="preco"
      href={`${FEEDS_URL}cmed/`}
      blurb="Quanto pode custar? A lista mensal, por substância e laboratório."
      stats={cmedStats}
      empty="Ainda sem lista guardada."
      links={[
        { href: `${FEEDS_URL}cmed/geral.xml`, text: "feed geral" },
        { href: `${FEEDS_URL}cmed/cmed.opml`, text: "OPML" },
      ]}
    />
    <Card
      title="dados abertos"
      icon="tabela"
      href={DADOS_URL}
      blurb="As tabelas em Parquet, com dicionário."
      stats={dadosStats}
      empty="Sem números neste build."
      links={[
        { href: "/dados/", text: "tabelas" },
        { href: docsUrl, text: "dicionário" },
      ]}
    />
  </section>

  <p class="nota">
    Fonte: <a href={ANVISA_DADOS_URL}>dados.anvisa.gov.br</a> e a API Consultas Externas. Nada aqui substitui a{" "}
    <a href={ANVISA_CONSULTAS_URL}>consulta oficial</a>.
  </p>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
